# Dusty Library server configuration.
#
# Copy to `.env` and adjust. `make dev` and `docker compose` load it
# automatically; for a bare binary export the variables or pass the equivalent
# flags (`dusty -addr ... -data ...`). Flags win over environment variables.
#
# The Flutter app needs no configuration: the web build uses the origin it is
# served from and the mobile app asks for the server address on first launch.

# Address the HTTP server listens on. Use 127.0.0.1:8080 to keep it local when
# running behind a reverse proxy.
DUSTY_ADDR=:8080

# Directory holding dusty.db (SQLite) and books/<id>.pdf. Back this directory
# up; nothing else holds state. Login sessions live in the database and never
# expire on their own; signing out revokes them.
DUSTY_DATA_DIR=./data

# Maximum size of a single uploaded PDF, in bytes (default 512 MiB).
DUSTY_MAX_UPLOAD_BYTES=536870912

# docker compose only: host port mapped to the container's 8080.
DUSTY_PORT=8080
